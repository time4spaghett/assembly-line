{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "assembly-line",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile", "-Command",
        "$env:ANTHROPIC_API_KEY = [Environment]::GetEnvironmentVariable('ANTHROPIC_API_KEY','User'); python -m streamlit run main.py --server.headless true --server.port 8503"
      ],
      "port": 8503
    }
  ]
}
